    "/home/finapp/bin/nightly-backup.sh": {
      "type": "file",
      "owner": "finapp",
      "group": "finapp",
      "permissions": "750",
      "created": "2024-05-18T09:00:00Z",
      "modified": "2024-05-18T09:00:00Z",
      "size_bytes": 352,
      "content": "#!/bin/bash\n# /home/finapp/bin/nightly-backup.sh\n# Runs via /etc/cron.d/fin-backup at 02:00 UTC nightly.\nset -euo pipefail\n\nDEST=/var/backups/finance\nTS=$(date -u +%Y%m%dT%H%M%SZ)\nmkdir -p \"$DEST\"\n\npg_dump -h localhost -U finapp_ro -Fc finance_prod \\\n  > \"$DEST/finance_prod-${TS}.pgdump\"\n\nfind \"$DEST\" -name 'finance_prod-*.pgdump' -mtime +30 -delete\n"
    },
