# Copy this file to .env and fill in real values. Never commit .env.

# LLM APIs (Module 3 — Response Engine)
ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here

# Threat intelligence (Module 5 — Threat Scorer)
ABUSEIPDB_API_KEY=your-abuseipdb-key-here

# Session store (Module 2 — Session Manager)
REDIS_URL=redis://localhost:6379/0
USE_IN_MEMORY_SESSIONS=true

# Honeypot runtime
HONEYPOT_SSH_PORT=2222
HONEYPOT_LOG_DIR=event_logging/logs
HONEYPOT_DEFAULT_PERSONA=generic_linux

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
